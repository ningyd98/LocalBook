/**
 * Opt-in integration test: the nested-document flow against a REAL backend.
 *
 * Vitest loads this file only as a dotenv entry point (see `vite.config.ts`),
 * so it sets `LOCALNOTE_E2E_BASE_URL` from the environment before any test file
 * reads `import.meta.env`. It is skipped unless that variable is set, which
 * keeps the default gates offline (PLAN/README: tests never touch a real Vault).
 *
 * How to run it against a disposable Vault:
 *
 *   mkdir -p /tmp/localnote-e2e/vault && printf '# A\n' > /tmp/localnote-e2e/vault/A.md
 *   LOCALNOTE_VAULT_ROOT=/tmp/localnote-e2e/vault LOCALNOTE_PORT=3799 \
 *     .venv/bin/python -m uvicorn server.api.main:app --port 3799 &
 *   pnpm --filter @localnote/web dev -- --port 5174 &   # proxies /api to 3799
 *   LOCALNOTE_E2E_BASE_URL=http://127.0.0.1:5174 pnpm --filter @localnote/web test
 */
export {};
